# 管理员账号和密码在首次打开后台时注册，并保存在 MongoDB 中。

# 至少 32 个随机字符，用于签名登录会话。
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_HOURS=12

# 32 字节随机值的 Base64。可用：openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# 请使用 URL 安全字符，避免在连接字符串中需要额外转义。
MONGO_ROOT_USERNAME=douyin_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_DATABASE=douyin_accounts

DOUYIN_CHECK_API_URL=https://unid.tztright.top/check
DOUYIN_PROFILE_API_URL=https://imdesktop.douyin.com/aweme/v1/web/user/profile/other/
QQ_OP_PROFILE_API_URL=https://graph.qq.com/user/get_simple_userinfo
# 支持 socks5://host:port、socks5://user:pass@host:port、host:port、host:port:user:pass。
# 多个代理可用英文逗号、分号或换行分隔。
QQ_OP_SOCKS_PROXY_URL=
QQ_OP_APP_ID=1105602870
QQ_OP_PROFILE_TIMEOUT_MS=5000
WEB_PORT=8080
TZ=Asia/Shanghai

# 本机 http://localhost 首次运行设为 false；接入 HTTPS 域名后必须改为 true。
COOKIE_SECURE=false
