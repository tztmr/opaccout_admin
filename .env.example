# 单一管理员账号。密码至少 12 位，建议使用随机值。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# 至少 32 个随机字符，用于签名登录会话。
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_HOURS=12

# 32 字节随机值的 Base64。可用：openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# 请使用 URL 安全字符，避免在连接字符串中需要额外转义。
MONGO_ROOT_USERNAME=douyin_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_DATABASE=douyin_accounts

DOUYIN_CHECK_API_URL=https://unid.tztright.top/check
WEB_PORT=8080
TZ=Asia/Shanghai

# 本机 http://localhost 首次运行设为 false；接入 HTTPS 域名后必须改为 true。
COOKIE_SECURE=false
